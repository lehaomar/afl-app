# Скопируйте этот файл в .env и заполните значения

PORT=3001
NODE_ENV=production

# ВАЖНО: смените на длинный случайный текст!
JWT_SECRET=замените_на_длинный_случайный_текст_минимум_32_символа

# Данные администратора
ADMIN_USERNAME=admin
ADMIN_PASSWORD=замените_на_надежный_пароль

# URL вашего Vercel-фронтенда (после деплоя)
FRONTEND_URL=https://ваш-проект.vercel.app

# Папки для данных (Railway volume)
DATA_DIR=/data
UPLOADS_DIR=/data/uploads
BACKUPS_DIR=/data/backups
